TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
SCENORA_TOKEN_PEPPER=replace-with-a-long-random-secret
PORT=8080

# Supabase Dashboard > Connect > Session pooler. Keep sslmode=require.
# Never put this value in Flutter code or commit the real .env file.
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
